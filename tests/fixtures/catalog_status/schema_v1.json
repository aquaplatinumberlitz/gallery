{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallery-repo.local/contracts/catalog-status/v1",
  "title": "Catalog status contract v1",
  "oneOf": [
    {
      "$ref": "#/$defs/UnifiedStatus"
    },
    {
      "$ref": "#/$defs/StatusResponseEnvelope"
    },
    {
      "$ref": "#/$defs/LibraryStatusBatchResponse"
    }
  ],
  "$defs": {
    "Timestamp": {
      "type": "integer",
      "exclusiveMinimum": 10000000000
    },
    "NullableTimestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "NullableNonNegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "NullableProgress": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "library_id", "path", "import_path_count"],
      "properties": {
        "kind": {
          "enum": ["library", "path"]
        },
        "library_id": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": ["string", "null"]
        },
        "import_path_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "available_paths", "total_paths"],
      "properties": {
        "state": {
          "enum": ["unknown", "available", "degraded", "unavailable"]
        },
        "available_paths": {
          "type": "integer",
          "minimum": 0
        },
        "total_paths": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "operation",
        "trigger",
        "active_job_id",
        "completed_units",
        "total_units",
        "progress_percent"
      ],
      "properties": {
        "state": {
          "enum": ["never", "queued", "scanning", "complete", "failed"]
        },
        "operation": {
          "enum": ["scan", "rebuild", null]
        },
        "trigger": {
          "enum": ["initial", "manual", "watcher", "scheduled", "startup", null]
        },
        "active_job_id": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "completed_units": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "total_units": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "progress_percent": {
          "$ref": "#/$defs/NullableProgress"
        }
      }
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "total_assets",
        "ready_assets",
        "not_ready_assets",
        "queued_assets",
        "running_assets",
        "stale_assets",
        "idle_pending_assets",
        "failed_assets",
        "progress_percent",
        "global_active_outside_scope"
      ],
      "properties": {
        "state": {
          "enum": [
            "disabled",
            "queued",
            "indexing",
            "needs_update",
            "complete",
            "failed"
          ]
        },
        "total_assets": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "ready_assets": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "not_ready_assets": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "queued_assets": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "running_assets": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "stale_assets": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "idle_pending_assets": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "failed_assets": {
          "$ref": "#/$defs/NullableNonNegativeInteger"
        },
        "progress_percent": {
          "$ref": "#/$defs/NullableProgress"
        },
        "global_active_outside_scope": {
          "type": "boolean"
        }
      }
    },
    "Issues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "scan", "metadata"],
      "properties": {
        "availability": {
          "type": "integer",
          "minimum": 0
        },
        "scan": {
          "type": "integer",
          "minimum": 0
        },
        "metadata": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "LatestIssue": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source", "path", "message", "updated_at"],
      "properties": {
        "source": {
          "enum": ["availability", "scan", "metadata"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "UnifiedStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "generated_at",
        "summary_state",
        "scope",
        "availability",
        "scan",
        "metadata",
        "issue_count",
        "issues",
        "latest_issue",
        "last_scan_at",
        "last_index_at"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "summary_state": {
          "enum": [
            "unknown",
            "offline",
            "needs_scan",
            "scanning",
            "indexing",
            "needs_update",
            "ready_with_issues",
            "ready",
            "error"
          ]
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "scan": {
          "$ref": "#/$defs/Scan"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "$ref": "#/$defs/Issues"
        },
        "latest_issue": {
          "$ref": "#/$defs/LatestIssue"
        },
        "last_scan_at": {
          "$ref": "#/$defs/NullableTimestamp"
        },
        "last_index_at": {
          "$ref": "#/$defs/NullableTimestamp"
        }
      }
    },
    "GlobalRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_worker_count",
        "catalog_active_jobs",
        "catalog_queue_depth",
        "metadata_worker_count",
        "metadata_active_jobs",
        "metadata_queue_depth",
        "metadata_staged_queue_depth",
        "watcher_enabled",
        "watcher_healthy",
        "watcher_issue",
        "scheduled_reconciliation_enabled"
      ],
      "properties": {
        "catalog_worker_count": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_active_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_queue_depth": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_worker_count": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_active_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_queue_depth": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_staged_queue_depth": {
          "type": "integer",
          "minimum": 0
        },
        "watcher_enabled": {
          "type": "boolean"
        },
        "watcher_healthy": {
          "type": "boolean"
        },
        "watcher_issue": {
          "type": ["string", "null"]
        },
        "scheduled_reconciliation_enabled": {
          "type": "boolean"
        }
      }
    },
    "StatusResponseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "status", "global_runtime"],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "status": {
          "$ref": "#/$defs/UnifiedStatus"
        },
        "global_runtime": {
          "$ref": "#/$defs/GlobalRuntime"
        }
      }
    },
    "LibraryStatusBatchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library_id", "status"],
      "properties": {
        "library_id": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/UnifiedStatus"
        }
      }
    },
    "LibraryStatusBatchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "generated_at",
        "items",
        "global_runtime"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LibraryStatusBatchItem"
          }
        },
        "global_runtime": {
          "$ref": "#/$defs/GlobalRuntime"
        }
      }
    }
  }
}
