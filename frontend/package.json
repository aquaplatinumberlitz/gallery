{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "VITE_MOBILE_NO_HMR=1 vite",
    "lint": "eslint \"src/**/*.{ts,vue}\" vite.config.ts vitest.config.ts playwright.config.ts --ignore-pattern \"src/**/__tests__/**\" --ignore-pattern \"src/test/**\" --max-warnings=0",
    "lint:tests": "eslint \"tests/**/*.ts\" \"src/**/__tests__/**/*.test.ts\" \"src/test/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,css,json}\" \"tests/**/*.{ts,json}\" \"*.{ts,js,json,html}\"",
    "format:check": "bash scripts/check_prettier_changed.sh",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "check:ui-tokens": "bash scripts/check_no_legacy_ui_tokens.sh",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "coverage:report": "nyc report --reporter=text --reporter=html --reporter=lcov",
    "coverage": "VITE_COVERAGE=true playwright test --project=chromium && nyc report --reporter=text --reporter=html --reporter=lcov",
    "perf:album": "playwright test tests/e2e/perf/album-open.perf.spec.ts --project=chromium",
    "perf:album:headed": "playwright test tests/e2e/perf/album-open.perf.spec.ts --project=chromium --headed",
    "perf:lightbox": "playwright test tests/e2e/perf/lightbox.perf.spec.ts --project=chromium",
    "perf:lightbox:headed": "playwright test tests/e2e/perf/lightbox.perf.spec.ts --project=chromium --headed",
    "perf:metadata": "GALLERY_PERF_METADATA=1 playwright test tests/e2e/metadata-performance.spec.ts --project=chromium",
    "perf:metadata:strict": "GALLERY_PERF_METADATA_STRICT=1 playwright test tests/e2e/metadata-performance.spec.ts --project=chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/vue-query-devtools": "^6.1.34",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eruda": "^3.4.3",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "nyc": "^17.1.0",
    "prettier": "^3.8.4",
    "sass": "^1.94.2",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.2.4",
    "vite-plugin-istanbul": "^7.0.0",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.4"
  },
  "dependencies": {
    "@douxcode/vue-spring-bottom-sheet": "^3.2.0",
    "@lucide/vue": "^1.18.0",
    "@tanstack/db": "^0.6.8",
    "@tanstack/query-db-collection": "^1.0.39",
    "@tanstack/vue-db": "^0.0.119",
    "@tanstack/vue-form": "^1.33.0",
    "@tanstack/vue-query": "^5.101.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.28",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "fuse.js": "^7.4.2",
    "lucide-vue-next": "^1.0.0",
    "photoswipe": "^5.4.4",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.10",
    "shadcn-vue": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  }
}
